# EKB 生产环境变量模板
# 复制此文件为 .env，填写所有标注 REQUIRED 的项。
# 切勿将 .env 提交到版本控制。

# ---- 应用环境 ----
EKB_ENV=production

# ---- 安全密钥（REQUIRED） ----
# 生产必须设置，禁止留空（服务启动时强制校验）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
EKB_TOKEN_SECRET=REPLACE_WITH_SECURE_RANDOM_VALUE

# ---- 数据库（REQUIRED） ----
POSTGRES_USER=ekb
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=ekb_prod
# 若使用外部 PostgreSQL，覆盖此连接串：
# EKB_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# ---- API 网络 ----
EKB_API_HOST=0.0.0.0
EKB_API_PORT=8000
EKB_ALLOWED_ORIGINS=https://your-domain.example.com

# ---- 模型提供商（至少配置一个 chat provider） ----
# JSON 数组，支持多 provider 自动 fallback
# kind: chat | embedding
EKB_MODEL_PROVIDERS='[{"name":"deepseek","kind":"chat","base_url":"https://api.deepseek.com/v1","api_key":"REPLACE_WITH_API_KEY","model":"deepseek-chat","timeout":30},{"name":"bge","kind":"embedding","base_url":"https://api.siliconflow.cn/v1","api_key":"REPLACE_WITH_API_KEY","model":"BAAI/bge-m3","timeout":20}]'

# ---- 检索参数 ----
EKB_RETRIEVAL_THRESHOLD=0.15
EKB_RETRIEVAL_RRF_K=60
EKB_RETRIEVAL_RERANK_POOL=20
EKB_RETRIEVAL_BM25=true

# ---- 生成参数 ----
EKB_LLM_TEMPERATURE=0.1
EKB_LLM_MAX_TOKENS=1024

# ---- 超时与熔断 ----
EKB_QA_TIMEOUT_SECONDS=60
EKB_SEARCH_TIMEOUT_SECONDS=10
EKB_CB_FAILURE_THRESHOLD=5
EKB_CB_RECOVERY_TIMEOUT=60

# ---- 告警阈值 ----
EKB_ALERT_QA_P95_SECONDS=3.0
EKB_ALERT_SEARCH_P95_SECONDS=0.5
EKB_ALERT_ERROR_RATE=0.05
EKB_ALERT_LLM_FAILURE_RATE=0.1

# ---- OpenTelemetry（可选） ----
# 配置后自动启用 OTLP trace 导出
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# ---- 开发专用（生产不应设置） ----
# EKB_DEV_USER_EMAIL=admin@example.com
# EKB_DEV_PASSWORD=change-me-local-only
# EKB_DEV_IS_PLATFORM_ADMIN=false
