# EKB 生产环境变量模板
# 复制此文件为 .env，填写所有标注 REQUIRED 的项。
# 切勿将 .env 提交到版本控制。

# ---- 应用环境 ----
EKB_ENV=production

# ---- 安全密钥（REQUIRED） ----
# 生产必须设置，禁止留空（服务启动时强制校验）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
EKB_TOKEN_SECRET=REPLACE_WITH_TOKEN_SECRET

# ---- 数据库（REQUIRED） ----
POSTGRES_USER=REPLACE_WITH_POSTGRES_USER
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=REPLACE_WITH_POSTGRES_DB
# 若使用外部 PostgreSQL，覆盖此连接串：
# EKB_DATABASE_URL=REPLACE_WITH_DATABASE_URL

# ---- API 网络 ----
# Compose 会在容器运行时注入实际 bind host；此处仅保留本地示例。
EKB_API_HOST=127.0.0.1
EKB_API_PORT=8000
EKB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- 模型提供商（至少配置一个 chat provider） ----
# JSON 数组，支持多 provider 自动 fallback；生产端点由受管运行环境填写。
# kind: chat | embedding
EKB_MODEL_PROVIDERS='[{"name":"chat-provider","kind":"chat","base_url":"https://api.example.invalid/v1","api_key":"REPLACE_WITH_API_KEY","model":"REPLACE_WITH_CHAT_MODEL","timeout":30},{"name":"embedding-provider","kind":"embedding","base_url":"https://embedding.example.invalid/v1","api_key":"REPLACE_WITH_API_KEY","model":"REPLACE_WITH_EMBEDDING_MODEL","timeout":20}]'

# ---- 检索参数 ----
EKB_RETRIEVAL_THRESHOLD=0.15
EKB_RETRIEVAL_RRF_K=60
EKB_RETRIEVAL_RERANK_POOL=20
EKB_RETRIEVAL_BM25=true

# ---- 生成参数 ----
EKB_LLM_TEMPERATURE=0.1
EKB_LLM_MAX_TOKENS=1024

# ---- 超时与熔断 ----
EKB_QA_TIMEOUT_SECONDS=60
EKB_SEARCH_TIMEOUT_SECONDS=10
EKB_CB_FAILURE_THRESHOLD=5
EKB_CB_RECOVERY_TIMEOUT=60

# ---- 告警阈值 ----
EKB_ALERT_QA_P95_SECONDS=3.0
EKB_ALERT_SEARCH_P95_SECONDS=0.5
EKB_ALERT_ERROR_RATE=0.05
EKB_ALERT_LLM_FAILURE_RATE=0.1

# ---- OpenTelemetry（可选） ----
# 配置后自动启用 OTLP trace 导出；生产端点由受管运行环境填写。
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.invalid/v1/traces

# ---- 开发专用（生产不应设置） ----
# EKB_DEV_USER_EMAIL=admin@example.com
# EKB_DEV_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
# EKB_DEV_IS_PLATFORM_ADMIN=false

# ---- M4-6 Multi-Turn Chat (源自 Grok chat-state 移植) ----
# 总开关：关闭则退化为单轮（便于线上回滚），默认 True
# EKB_MULTI_TURN_ENABLED=true
# 模型上下文窗口 tokens，默认 16k（deepseek-v4-flash 保守值；pro 可开到 128k，后续可按 provider 动态）
# EKB_LLM_CONTEXT_WINDOW=16384
# 触发压缩的 tokens 阈值比例（历史估算 > window × 此比例 就压缩），默认 0.75
# EKB_LLM_COMPACTION_RATIO=0.75
# 压缩时最近保留的 USER+ASSISTANT 对数，默认 6（即最近 12 条消息原封不动）
# EKB_COMPACTION_RECENT_ROUNDS_KEEP=6
# 压缩后 summary tokens 必须 < 被压缩原始 tokens × 此比例（否则 hard_truncate 兜底），默认 0.6
# EKB_COMPACTION_SUMMARY_RATIO_TARGET=0.6
