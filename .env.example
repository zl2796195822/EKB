EKB_ENV=development
EKB_API_HOST=127.0.0.1
EKB_API_PORT=8000
EKB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EKB_DEV_USER_EMAIL=admin@example.com
EKB_DEV_USER_NAME=EKB Admin
EKB_DEV_PASSWORD=change-me-local-only
# Leave unset in local development to use an ephemeral startup secret.
# Set a strong value in shared environments.
EKB_TOKEN_SECRET=

# 持久化数据库。本地默认 SQLite 文件即可运行；生产指向 PostgreSQL（建议启用 pgvector）。
# 例：postgresql+psycopg://user:pass@127.0.0.1:5432/ekb
EKB_DATABASE_URL=sqlite:///./ekb_dev.db

# ============================================================
# 多模型提供商：兼容任意 OpenAI 兼容端点（DeepSeek / OpenAI GPT / MiniMax / Kimi 等）
# ------------------------------------------------------------
# EKB_MODEL_PROVIDERS 是一个 JSON 数组，每项：
#   { "name": 标识, "kind": "chat" | "embedding", "base_url": 端点, "api_key": 密钥,
#     "model": 模型名, "timeout": 秒 }
# 运行时：
#   - chat：按列表顺序依次尝试，首个成功即用，失败自动切换下一个 provider（提升可用性）。
#   - embedding：同上。
#   - api_key 为空的 provider 视为未启用，自动跳过（方便先占位、后填 key）。
# 也可只填一个（如只用 DeepSeek）。未来前端「选模型」可传 provider_name 指定。
# 注意：base_url 必须是该服务的 OpenAI 兼容端点；DeepSeek 不提供 embedding，
#       嵌入向量需另配支持 embeddings 的 provider（如 OpenAI / 硅基流动 BGE-M3）。
# 兼容旧配置：若未设置 EKB_MODEL_PROVIDERS，系统回退读取下列单组 env（保留以便平滑迁移）。
#   EKB_LLM_API_URL=https://api.deepseek.com/v1/chat/completions
#   EKB_LLM_API_KEY=your-deepseek-key
#   EKB_LLM_MODEL=deepseek-chat
#   EKB_EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
#   EKB_EMBEDDING_API_KEY=your-embedding-key
#   EKB_EMBEDDING_MODEL=text-embedding-3-small
# ============================================================
EKB_MODEL_PROVIDERS='[{"name":"deepseek","kind":"chat","base_url":"https://api.deepseek.com/v1/chat/completions","api_key":"your-deepseek-key","model":"deepseek-chat","timeout":30},{"name":"openai","kind":"chat","base_url":"https://api.openai.com/v1/chat/completions","api_key":"your-openai-key","model":"gpt-4o-mini","timeout":30},{"name":"minimax","kind":"chat","base_url":"https://api.minimax.chat/v1/text/chatcompletion_v2","api_key":"your-minimax-key","model":"abab6.5s-chat","timeout":30},{"name":"kimi","kind":"chat","base_url":"https://api.moonshot.cn/v1/chat/completions","api_key":"your-kimi-key","model":"moonshot-v1-8k","timeout":30},{"name":"openai-embedding","kind":"embedding","base_url":"https://api.openai.com/v1/embeddings","api_key":"your-openai-key","model":"text-embedding-3-small","timeout":30}]'

# 生成/改写温度（0 = 确定性，锁定评估门禁）
EKB_LLM_TEMPERATURE=0

# 本地降级向量维度（仅 embedding 全部 provider 失败时降级使用，无真实语义）
EKB_EMBEDDING_DIM=256
EKB_EMBEDDING_BATCH_SIZE=32

# 检索余弦相似度阈值：低于此值视为无证据，走拒答
EKB_RETRIEVAL_THRESHOLD=0.15

# M1-05 检索强化参数
# RRF 融合常数（排名衰减，越大越弱化靠后排名的影响）
EKB_RETRIEVAL_RRF_K=60
# Rerank 候选池大小：融合后进入精排的候选上限
EKB_RETRIEVAL_RERANK_POOL=20
# 是否启用 BM25 词法重排信号（true/false）
EKB_RETRIEVAL_BM25=true
