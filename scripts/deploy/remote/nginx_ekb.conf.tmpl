# EKB nginx vhost template (CentOS/Debian 通用)
#  · 静态 / = /opt/ekb/web/current (dist/)
#  · /api /healthz /docs /openapi.json → 127.0.0.1:8000 (uvicorn / docker)
#  · DEPLOY_HOST / public DNS must be supplied by the deployment environment.

upstream ekb_api {
  server 127.0.0.1:8000 max_fails=3 fail_timeout=10s;
  keepalive 32;
}

server {
  listen 80 default_server;
  listen [::]:80 default_server;

  # The deployment environment may replace the placeholder before installation.
  # The wildcard fallback keeps this template free of a production hostname.
  server_name _;

  charset utf-8;
  server_tokens off;

  # 上传文件：后端允许 100MB，nginx 对齐
  client_max_body_size 100m;
  client_body_timeout 60s;
  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    application/javascript application/json application/xml
    text/css text/javascript text/plain text/xml
    image/svg+xml font/woff2 font/woff application/vnd.ms-fontobject;

  # 访问日志（轻量，关闭注释可启用）
  access_log /var/log/nginx/ekb.access.log;
  error_log  /var/log/nginx/ekb.error.log warn;

  # ===== 静态前端：/opt/ekb/web/current（Vite dist）=====
  set $web_root /opt/ekb/web/current;
  root $web_root;

  # /healthz → 先给 nginx 自身静态响应；然后也把路径透传后端方便容器监控
  location = /healthz-nginx {
    access_log off;
    default_type application/json;
    return 200 '{"ok":true,"service":"nginx","ts":""}';
  }

  # ===== API / 监控 / 文档 → FastAPI =====
  location ~ ^/(api|healthz|health|docs|openapi\.json|redoc|metrics|sso|auth|oauth2)(/|$) {
    proxy_http_version 1.1;
    proxy_set_header Host               $host;
    proxy_set_header X-Real-IP          $remote_addr;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Host   $host;
    proxy_set_header Connection         "";
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_connect_timeout 5s;
    proxy_buffering on;
    proxy_request_buffering off;
    proxy_pass http://ekb_api;
  }

  # ===== SPA 前端：静态 + 404 回退到 index.html =====
  location / {
    try_files $uri $uri/ /index.html;
    # 缓存策略：Vite 用 chunkhash 做文件名，assets/ 缓存 1 年
    location ~* ^/assets/ {
      expires 1y;
      add_header Cache-Control "public, immutable";
      access_log off;
      try_files $uri =404;
    }
    location = /index.html {
      add_header Cache-Control "no-cache, no-store, must-revalidate";
      add_header Pragma "no-cache";
      add_header Expires "0";
    }
  }

  # ===== 安全相关：屏蔽 .env / .git / .sql 等敏感文件 =====
  location ~ /\.(?!well-known) {
    deny all;
  }
  location ~* \.(env|sql|bak|swp|log|pid|ini)$ {
    deny all;
  }
}
