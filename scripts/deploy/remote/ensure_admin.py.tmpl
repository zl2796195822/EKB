#!/usr/bin/env python3
"""Create the configured administrator once and reconcile its v3 projection.

This remains a self-contained deployment wrapper because legacy deployment
scripts copy it to the release root as ``ensure_admin.py``.
"""
from __future__ import annotations

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

from ekb_api.core.config import get_settings  # noqa: E402
from ekb_api.core.db import build_engine  # noqa: E402
from ekb_api.ops.admin_access import (  # noqa: E402
    ensure_configured_admin,
    validate_runtime_admin,
)


def main() -> int:
    settings = get_settings()
    email = os.environ.get("EKB_DEV_USER_EMAIL", settings.dev_user_email)
    name = os.environ.get("EKB_DEV_USER_NAME", settings.dev_user_name)
    password = os.environ.get("EKB_DEV_PASSWORD", settings.dev_password)
    try:
        validate_runtime_admin(
            email=email,
            name=name,
            password=password,
            production=settings.is_production,
        )
        result = ensure_configured_admin(
            build_engine(settings.database_url),
            email=email,
            name=name,
            password=password,
        )
    except (RuntimeError, ValueError):
        print("runtime administrator initialization refused", file=sys.stderr)
        return 78
    print(
        "runtime administrator initialization passed "
        f"created_user={result.created_user} "
        f"created_membership={result.created_membership} "
        f"reconciled_membership={result.reconciled_membership}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
