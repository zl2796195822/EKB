# EKB 服务器环境变量（部署在 /opt/ekb/api/.env）
# TOKEN_SECRET and admin identity must be injected by the runtime secret manager.
# This template intentionally contains no secret or default administrator.

EKB_ENV=production

# === REQUIRED runtime values ===
EKB_TOKEN_SECRET=

# === 管理员账号（运行时受管配置必填）===
EKB_DEV_USER_EMAIL=
EKB_DEV_USER_NAME=
EKB_DEV_PASSWORD=
EKB_DEV_IS_PLATFORM_ADMIN=false

# === 数据库：SQLite（服务器单机验收用）===
EKB_DATABASE_URL=sqlite:////opt/ekb/data/ekb_prod.db

# === 网络 ===
EKB_API_HOST=127.0.0.1
EKB_API_PORT=8000
EKB_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# === LLM / Embedding Providers（占位：未配 real key 时 AI 问答降级，页面功能可验收）===
# 填入真实 DeepSeek / SiliconFlow key 后即可启用 AI 问答。
EKB_MODEL_PROVIDERS=[]

# === 检索 & 生成参数（保持默认）===
EKB_RETRIEVAL_THRESHOLD=0.15
EKB_RETRIEVAL_RRF_K=60
EKB_RETRIEVAL_RERANK_POOL=20
EKB_RETRIEVAL_BM25=true
EKB_LLM_TEMPERATURE=0.1
EKB_LLM_MAX_TOKENS=1024

# === 超时 & 熔断 ===
EKB_QA_TIMEOUT_SECONDS=60
EKB_SEARCH_TIMEOUT_SECONDS=10
EKB_CB_FAILURE_THRESHOLD=5
EKB_CB_RECOVERY_TIMEOUT=60

# === 告警阈值（暂不启用告警通道，仅暴露在 ops dashboard）===
EKB_ALERT_QA_P95_SECONDS=3.0
EKB_ALERT_SEARCH_P95_SECONDS=0.5
EKB_ALERT_ERROR_RATE=0.05
EKB_ALERT_LLM_FAILURE_RATE=0.1
